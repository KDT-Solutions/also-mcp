# Set these as secrets/env vars in Portainer (or copy to .env for docker compose).
# Never commit a real .env file.

ALSO_API_USER=api.user@example.ch
ALSO_API_PASSWORD=changeme

# Required (the server refuses to start without it). Generate with: openssl rand -hex 32
# Every request must then send: Authorization: Bearer <this value>
MCP_API_KEY=

# Optional overrides:
# ALSO_BASE_URL=https://marketplace.also.ch/SimpleAPI/SimpleAPIService.svc/rest
# MCP_HOST=0.0.0.0
# MCP_PORT=8000
# MCP_HOST_PORT=8424
